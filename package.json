{
  "name": "arb-pos-erp",
  "version": "1.0.0",
  "description": "Windows Desktop POS & ERP Application - Phase 1",
  "main": "electron/main/index.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build",
    "build": "vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "start": "electron .",
    "dist": "npm run build && npx electron-builder",
    "test:migrations": "echo 'IMPORTANT: better-sqlite3 requires Electron Node ABI. Run migrations.test.js via: electron electron/database/migrations.test.js (after npm rebuild)'"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.2",
    "antd": "^5.24.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.arbpos.erp",
    "productName": "ARB POS & ERP",
    "npmRebuild": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "signingHashAlgorithms": [],
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ARB POS & ERP"
    }
  }
}
